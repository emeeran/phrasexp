{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhraseXp",
  "version": "1.10.0",
  "identifier": "com.phrasexp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhraseXp",
        "width": 1100,
        "height": 720
      },
      {
        "label": "popup",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "focus": false,
        "width": 560,
        "height": 420,
        "minWidth": 280,
        "minHeight": 120
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "publisher": "Dawnstar",
    "category": "Utility",
    "shortDescription": "Lightweight local-first text expander",
    "longDescription": "PhraseXp is a lightweight, local-first text expander. Type an abbreviation to expand it into a full phrase, or summon a search popup with a global hotkey. Clipboard history, macros, and system-tray integration included.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
